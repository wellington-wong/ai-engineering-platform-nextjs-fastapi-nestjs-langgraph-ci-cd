// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model SystemMetric {

    id                      Int         @id @default(autoincrement())
    timestamp               DateTime    @default(now())
    cpuUsagePercent         Float
    memoryUsagePercent      Float
    diskUsagePercent        Float
    uptimeSeconds           Float

    @@index([timestamp])

}

model ContainerMetric {
    id                  Int         @id @default(autoincrement())
    timestamp           DateTime    @default(now())
    containerId         String


    containerName       String
    cpuUsagePercent     Float
    memoryUsageBytes    Float
    memoryLimitBytes    Float

    networkRxBytes      Float?
    networkTxBytes      Float?




    blockIoReadBytes    Float?
    blockIoWriteBytes   Float?

    pidsCurrent         Int?
    pidsLimit           Int?

    @@index([containerId, timestamp])



}


model Monitor {
    id              Int         @id @default(autoincrement())
    name            String
    url             String
    enabled         Boolean     @default(true)
    createdAt       DateTime    @default(now())
    updatedAt       DateTime    @updatedAt

    healthChecks    HealthCheck[]

    @@index([enabled])
}

model HealthCheck {
    id              Int         @id @default(autoincrement())
    monitorId       Int
    timestamp       DateTime    @default(now())


    healthy         Boolean
    statusCode      Int?
    responseTimeMs  Float
    error           String?

    monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)






    @@index([monitorId, timestamp])
}